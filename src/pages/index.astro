---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import Bento from '../components/home/Bento.astro';
import Devices from '../components/home/Devices.astro';
import ImportSteps from '../components/home/ImportSteps.astro';
import Guides from '../components/home/Guides.astro';
import HelpCallouts from '../components/home/HelpCallouts.astro';
import FamilyBlock from '../components/FamilyBlock.astro';
import Faq from '../components/home/Faq.astro';
import { SITE, ORG_ID, abs } from '../config/site';
import { FAQS, stripHtml } from '../data/faq';

const jsonLd = [
  {
    '@type': 'WebPage',
    '@id': abs('/#webpage'),
    url: abs('/'),
    name: SITE.defaultTitle,
    description: SITE.defaultDescription,
    inLanguage: SITE.lang,
    isPartOf: { '@id': abs('/#website') },
    about: { '@id': ORG_ID },
    dateModified: SITE.dataUpdated,
  },
  {
    '@type': 'FAQPage',
    '@id': abs('/#faq'),
    url: abs('/'),
    inLanguage: SITE.lang,
    isPartOf: { '@id': abs('/#website') },
    mainEntity: FAQS.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a.map(stripHtml).join('\n') },
    })),
  },
];
---
<BaseLayout title={SITE.defaultTitle} description={SITE.defaultDescription} path="/" jsonLd={jsonLd}>
  <Hero />
  <Bento />
  <Devices />
  <ImportSteps />
  <Guides />
  <HelpCallouts />
  <FamilyBlock />
  <Faq />
</BaseLayout>
