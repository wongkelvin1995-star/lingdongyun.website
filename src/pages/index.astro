---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import BrandFacts from '../components/home/BrandFacts.astro';
import Services from '../components/home/Services.astro';
import Plans from '../components/home/Plans.astro';
import Clients from '../components/home/Clients.astro';
import Guides from '../components/home/Guides.astro';
import Reviews from '../components/home/Reviews.astro';
import Scenarios from '../components/home/Scenarios.astro';
import Faq from '../components/home/Faq.astro';
import BuyingGuide from '../components/home/BuyingGuide.astro';
import { SITE, abs, BRAND_ALIASES, BRAND_KEYWORDS } from '../config/site';
import { FAQS, stripHtml } from '../data/faq';
import { PLANS, getPlan } from '../data/plans';

const minMonthly = Math.min(...PLANS.filter((p) => p.paymentCycle === 'month').map((p) => p.priceAmount));
const yearPlan = getPlan('chuanyun');
const description = `灵动云（Lingdongyun，又称灵动云机场、灵动云VPN）官网：月付 ¥${minMonthly} 起、年付 ${yearPlan.displayPrice}${yearPlan.displayPriceSuffix}、不限时流量包共 ${PLANS.length} 档套餐，支持 Clash、小火箭、v2rayN 订阅导入，附科学上网教程与官方注册入口。`;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': abs('/#website'),
    name: SITE.name,
    alternateName: [SITE.brand, ...BRAND_ALIASES],
    url: abs('/'),
    inLanguage: SITE.lang,
    description,
    publisher: { '@id': abs('/#organization') },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': abs('/#organization'),
    name: SITE.brand,
    alternateName: [...BRAND_ALIASES],
    url: abs('/'),
    logo: abs('/apple-touch-icon.png'),
    description: `${SITE.brand}（${SITE.latinName}）是提供网络连接订阅服务的品牌，常被称为灵动云机场、灵动云VPN，提供月付、年付与一次性流量包套餐。`,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    '@id': abs('/#faq'),
    inLanguage: SITE.lang,
    mainEntity: FAQS.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a.map(stripHtml).join('\n') },
    })),
  },
];
---
<BaseLayout description={description} jsonLd={jsonLd} keywords={BRAND_KEYWORDS}>
  <Hero />
  <BrandFacts />
  <Services />
  <Plans />
  <Clients />
  <Guides />
  <Reviews />
  <Scenarios />
  <BuyingGuide />
  <Faq />
</BaseLayout>
