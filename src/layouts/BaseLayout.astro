---
// 唯一自托管字体：Spline Sans Mono（仅拉丁子集，400 / 500，font-display: swap），用于等宽细节
import '@fontsource/spline-sans-mono/latin-400.css';
import '@fontsource/spline-sans-mono/latin-500.css';
import '../styles/global.css';
import { SITE, ORG_ID, abs } from '../config/site';
import Header from '../components/Header.astro';
import MotionHead from '../components/MotionHead.astro';
import MotionIntro from '../components/MotionIntro.astro';
import MotionReveal from '../components/MotionReveal.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  /** 不传则使用当前路径 */
  path?: string;
  ogType?: 'website' | 'article';
  /** 页面自身的结构化数据节点（不含 @context），与组织、站点节点合并为一个 @graph */
  jsonLd?: Record<string, unknown>[];
  noindex?: boolean;
  publishedTime?: string;
  modifiedTime?: string;
}

const {
  title = SITE.defaultTitle,
  description = SITE.defaultDescription,
  path = Astro.url.pathname,
  ogType = 'website',
  jsonLd = [],
  noindex = false,
  publishedTime,
  modifiedTime,
} = Astro.props;

const canonical = abs(path);
// 图标版本号：更换 Logo 后修改此值，强制浏览器重新下载标签页图标
// 2026-11-01：换为官方 Logo（public/brand/logo.svg，favicon.svg 为同一文件）
const ICON_V = '20261101';
const ogImage = abs(SITE.ogImage);

/**
 * 结构化数据：灵动云组织实体使用本站自己的 @id（最小节点），
 * 本站 WebSite 由该组织发布；页面节点通过 @id 引用二者。
 */
const graph = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'Organization', '@id': ORG_ID, name: SITE.brand, url: abs('/') },
    {
      '@type': 'WebSite',
      '@id': abs('/#website'),
      url: abs('/'),
      name: SITE.name,
      description: SITE.defaultDescription,
      inLanguage: SITE.lang,
      publisher: { '@id': ORG_ID },
    },
    ...jsonLd,
  ],
};
---
<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- 出场动态：判断是否播放 + 样式（tools/motion.py） -->
    <MotionHead />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex, follow" /> : <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#0a0a0b" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href={`/favicon.svg?v=${ICON_V}`} type="image/svg+xml" />
    <link rel="icon" href={`/favicon.ico?v=${ICON_V}`} sizes="32x32" />
    <link rel="apple-touch-icon" href={`/apple-touch-icon.png?v=${ICON_V}`} />

    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={SITE.ogImageAlt} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(graph)} />
    <!-- 悬停或按下链接时预先加载同站页面，点击后打开更快（只在支持的浏览器生效） -->
    <script type="speculationrules" is:inline set:html={"{\"prefetch\":[{\"where\":{\"and\":[{\"href_matches\":\"/*\"},{\"not\":{\"selector_matches\":\"[target=_blank], [download], [rel~=nofollow]\"}}]},\"eagerness\":\"moderate\"}]}"}></script>
  </head>
  <body>
    <MotionIntro />
    <a class="skip-link" href="#main">跳到主要内容</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <MotionReveal />
  </body>
</html>
