---
interface Props {
  items: { label: string; href?: string }[];
}
const { items } = Astro.props;
---
<nav class="crumbs" aria-label="面包屑">
  <ol>
    {items.map((it, i) => (
      <li>
        {it.href && i < items.length - 1 ? <a href={it.href}>{it.label}</a> : <span aria-current="page">{it.label}</span>}
      </li>
    ))}
  </ol>
</nav>

<style>
  .crumbs ol {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    margin: 0;
    padding: 0;
    font-size: 13.5px;
    color: var(--muted);
  }
  .crumbs li {
    display: inline-flex;
    align-items: center;
    min-width: 0;
  }
  .crumbs li + li::before {
    content: '/';
    margin: 0 10px;
    font-family: var(--mono);
    color: var(--dim);
    opacity: 0.7;
  }
  .crumbs a {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    color: var(--text-2);
    text-decoration: none;
  }
  .crumbs a:hover {
    color: var(--accent);
  }
  .crumbs span {
    color: var(--dim);
  }
  @media (max-width: 959px) {
    .crumbs a {
      min-height: 44px;
    }
  }
</style>
