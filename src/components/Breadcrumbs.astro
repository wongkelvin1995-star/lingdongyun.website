---
interface Props {
  items: { label: string; href?: string }[];
}
const { items } = Astro.props;
---
<nav class="crumbs" aria-label="面包屑">
  <ol>
    {items.map((it, i) => (
      <li>
        {it.href && i < items.length - 1 ? <a href={it.href}>{it.label}</a> : <span aria-current="page">{it.label}</span>}
      </li>
    ))}
  </ol>
</nav>

<style>
  .crumbs ol {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    margin: 0;
    padding: 0;
    font-size: 14px;
    color: var(--muted);
  }
  .crumbs li + li::before {
    content: '/';
    margin: 0 6px 0 2px;
    color: #a3a4b8;
  }
  .crumbs a {
    color: var(--text);
    text-decoration: none;
  }
  .crumbs a:hover {
    color: var(--brand-ink);
    text-decoration: underline;
  }
  .crumbs span {
    color: var(--muted);
  }
</style>
