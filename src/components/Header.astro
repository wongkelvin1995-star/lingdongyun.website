---
import { NAV, SITE } from '../config/site';
import Logo from './Logo.astro';
import ActionLink from './ActionLink.astro';

const path = Astro.url.pathname;
const onHome = path === '/';
// 首页使用短锚点 #devices；其他页面保留 /#devices 以返回首页对应区域
const resolve = (href: string) => (onHome && href.startsWith('/#') ? href.slice(1) : href);
const isCurrent = (href: string) =>
  (href === '/' && onHome) || (href === '/guides/' && path.startsWith('/guides/'));
---
<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label={`${SITE.name}首页`}>
      <Logo size={30} />
      <span class="brand-text">
        <span class="brand-name">{SITE.brand}</span>
        <span class="brand-dot" aria-hidden="true">·</span>
        <span class="brand-role">{SITE.role}</span>
      </span>
    </a>

    <nav class="main-nav" id="main-nav" aria-label="主导航">
      <ul>
        {NAV.map((item) => (
          <li>
            <a href={resolve(item.href)} aria-current={isCurrent(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
      <div class="nav-cta-mobile">
        <ActionLink block>注册 / 登录</ActionLink>
      </div>
    </nav>

    <div class="header-actions">
      <ActionLink size="sm" class="header-cta">立即注册</ActionLink>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="main-nav">
        <span class="visually-hidden">打开菜单</span>
        <span class="bars" aria-hidden="true"><span></span><span></span><span></span></span>
      </button>
    </div>
  </div>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const nav = document.getElementById('main-nav');
  if (btn && nav) {
    const label = btn.querySelector('.visually-hidden');
    const setOpen = (open: boolean) => {
      btn.setAttribute('aria-expanded', String(open));
      nav.classList.toggle('is-open', open);
      if (label) label.textContent = open ? '关闭菜单' : '打开菜单';
    };
    btn.addEventListener('click', () => setOpen(btn.getAttribute('aria-expanded') !== 'true'));
    nav.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && nav.classList.contains('is-open')) {
        setOpen(false);
        btn.focus();
      }
    });
    window.matchMedia('(min-width: 960px)').addEventListener('change', (m) => m.matches && setOpen(false));
  }
</script>


<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(10, 10, 11, 0.78);
    backdrop-filter: saturate(140%) blur(14px);
    -webkit-backdrop-filter: saturate(140%) blur(14px);
    border-bottom: 1px solid var(--line);
  }
  .header-inner {
    display: flex;
    align-items: center;
    gap: 24px;
    height: var(--header-h);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    flex: none;
    color: var(--text);
    text-decoration: none;
  }
  .brand-text {
    display: inline-flex;
    align-items: baseline;
    gap: 7px;
    white-space: nowrap;
  }
  .brand-name {
    font-size: 17px;
    font-weight: 600;
    letter-spacing: 0.02em;
  }
  .brand-dot {
    color: var(--dim);
  }
  .brand-role {
    font-size: 14.5px;
    font-weight: 500;
    color: var(--accent);
    letter-spacing: 0.04em;
  }
  .brand:hover {
    color: var(--text);
  }
  .brand:hover .brand-role {
    color: var(--accent-hi);
  }
  .main-nav {
    margin-left: auto;
  }
  .main-nav ul {
    display: flex;
    gap: 2px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .main-nav ul a {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0 12px;
    border-radius: 8px;
    color: var(--muted);
    font-size: 14.5px;
    text-decoration: none;
    transition: color 0.15s ease, background-color 0.15s ease;
  }
  .main-nav ul a:hover {
    color: var(--text);
    background: rgba(255, 255, 255, 0.04);
  }
  .main-nav ul a[aria-current='page'] {
    color: var(--text);
    background: rgba(255, 255, 255, 0.06);
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .nav-cta-mobile {
    display: none;
  }
  .header-actions {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .menu-toggle {
    display: none;
    width: 44px;
    height: 44px;
    border: 1px solid var(--line-strong);
    background: rgba(255, 255, 255, 0.02);
    border-radius: var(--r-sm);
    cursor: pointer;
    align-items: center;
    justify-content: center;
  }
  .menu-toggle:hover {
    border-color: var(--accent-line);
  }
  .bars {
    display: grid;
    gap: 4px;
  }
  .bars span {
    display: block;
    width: 18px;
    height: 1.5px;
    background: var(--text);
    border-radius: 2px;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }
  .menu-toggle[aria-expanded='true'] .bars span:nth-child(1) {
    transform: translateY(5.5px) rotate(45deg);
  }
  .menu-toggle[aria-expanded='true'] .bars span:nth-child(2) {
    opacity: 0;
  }
  .menu-toggle[aria-expanded='true'] .bars span:nth-child(3) {
    transform: translateY(-5.5px) rotate(-45deg);
  }

  @media (max-width: 959px) {
    .header-inner {
      justify-content: space-between;
    }
    .menu-toggle {
      display: inline-flex;
    }
    .main-nav {
      display: none;
      position: absolute;
      left: 0;
      right: 0;
      top: 100%;
      background: var(--bg-band);
      border-bottom: 1px solid var(--line-strong);
      box-shadow: 0 24px 48px -12px rgba(0, 0, 0, 0.8);
      padding: 8px var(--gutter) 20px;
    }
    .main-nav.is-open {
      display: block;
    }
    .main-nav ul {
      flex-direction: column;
      gap: 0;
    }
    .main-nav li + li {
      border-top: 1px solid var(--line);
    }
    .main-nav ul a {
      width: 100%;
      min-height: 48px;
      padding: 0 4px;
      font-size: 16px;
      color: var(--text-2);
      border-radius: 0;
    }
    .main-nav ul a:hover,
    .main-nav ul a[aria-current='page'] {
      background: none;
      box-shadow: none;
      color: var(--accent);
    }
    .nav-cta-mobile {
      display: block;
      margin-top: 12px;
    }
  }
  @media (max-width: 420px) {
    .brand {
      gap: 8px;
    }
    .brand-name {
      font-size: 16px;
    }
    .brand-role {
      font-size: 14px;
    }
    .header-actions :global(.header-cta) {
      display: none;
    }
  }
</style>
