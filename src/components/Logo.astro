---
/**
 * 灵动云 Logo —— 全站唯一来源：public/brand/logo.svg（官方 Logo，2026-11-01）。
 * 页眉、页脚、404 等所有出现 Logo 的地方都用这个组件；更换 Logo 时只替换这一个文件，
 * 并同步 public/favicon.svg（同一文件）、favicon.ico、apple-touch-icon.png，
 * 再修改 BaseLayout.astro 里的 ICON_V 让浏览器刷新标签页图标。
 * 文字「灵动云」与角色标签由调用方紧跟在 Logo 后面输出，因此这里 alt 为空。
 */
interface Props {
  size?: number;
  /** 首屏以外（如页脚）可延迟加载 */
  lazy?: boolean;
  class?: string;
}
const { size = 32, lazy = false, class: cls } = Astro.props;
---
<img
  class:list={['logo', cls]}
  src="/brand/logo.svg"
  width={size}
  height={size}
  alt=""
  decoding="async"
  loading={lazy ? 'lazy' : undefined}
/>

<style>
  .logo {
    flex: none;
    border-radius: 20%;
    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.08), 0 6px 18px -6px rgba(98, 3, 251, 0.55);
  }
</style>
