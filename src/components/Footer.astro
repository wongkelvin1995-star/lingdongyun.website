---
import { NAV, SITE } from '../config/site';
import Logo from './Logo.astro';
import ActionLink from './ActionLink.astro';

const onHome = Astro.url.pathname === '/';
const resolve = (href: string) => (onHome && href.startsWith('/#') ? href.slice(1) : href);
const year = new Date(SITE.dataUpdated).getFullYear();
const tutorials = [
  { href: '/guides/choose-client/', label: '按设备选客户端' },
  { href: '/guides/clash-subscription/', label: 'Clash 订阅导入' },
  { href: '/guides/clash-party/', label: 'Clash Party 教程' },
  { href: '/guides/shadowrocket/', label: '小火箭教程' },
  { href: '/guides/windows-android-clients/', label: 'v2rayN / v2rayNG 教程' },
];
---
<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <a class="brand" href="/">
        <Logo size={32} lazy />
        <span>{SITE.brand}<span class="f-dot" aria-hidden="true"> · </span><span class="f-role">{SITE.role}</span></span>
      </a>
      <p>
        按设备整理灵动云的客户端安装、订阅导入与节点设置教程。注册和购买在用户中心完成，订阅链接请向在线客服领取。
      </p>
      <ActionLink variant="ghost" size="sm">注册 / 登录用户中心</ActionLink>
    </div>

    <nav class="footer-col" aria-label="页脚导航">
      <h2>站内导航</h2>
      <ul>
        {NAV.map((n) => <li><a href={resolve(n.href)}>{n.label}</a></li>)}
      </ul>
    </nav>

    <div class="footer-col">
      <h2>常用教程</h2>
      <ul>
        {tutorials.map((t) => <li><a href={t.href}>{t.label}</a></li>)}
      </ul>
    </div>
  </div>

  <div class="container footer-bottom">
    <p class="footer-statement">
      本站是灵动云官方「{SITE.role}」站点，只讲客户端安装、订阅导入和日常设置。
    </p>
    <p>价格与套餐规则以用户中心实时显示为准。请在所在地法律法规允许的范围内使用网络服务。</p>
    <p class="footer-copy">© {year} {SITE.name} · <span class="mono">{SITE.domain}</span></p>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    background: var(--bg);
    border-top: 1px solid var(--line);
    padding: 64px 0 32px;
    font-size: 14px;
    color: var(--muted);
  }
  /* 顶边一道居中的青色细光 */
  .site-footer::before {
    content: '';
    position: absolute;
    top: -1px;
    left: 50%;
    width: min(640px, 80%);
    height: 1px;
    transform: translateX(-50%);
    background: linear-gradient(90deg, transparent, rgba(206, 181, 249, 0.55), transparent);
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr;
    gap: 40px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    min-height: 44px;
    margin-bottom: 12px;
    color: var(--text);
    font-size: 17px;
    font-weight: 600;
    letter-spacing: 0.02em;
    text-decoration: none;
  }
  .brand:hover {
    color: var(--text);
  }
  .f-dot {
    color: var(--dim);
  }
  .f-role {
    color: var(--accent);
    font-size: 15px;
    font-weight: 500;
  }
  .footer-brand p {
    max-width: 380px;
    margin-bottom: 20px;
    line-height: 1.8;
  }
  .footer-col h2 {
    font-size: 13px;
    font-weight: 500;
    color: var(--dim);
    letter-spacing: 0.06em;
    margin-bottom: 12px;
  }
  .footer-col ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
  }
  .footer-col a {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    color: var(--text-2);
    text-decoration: none;
  }
  .footer-col a:hover {
    color: var(--accent);
  }
  .footer-bottom {
    position: relative;
    margin-top: 48px;
    padding-top: 24px;
    display: grid;
    gap: 6px;
    font-size: 13px;
  }
  /* 分隔线与内容同宽（不含容器左右留白） */
  .footer-bottom::before {
    content: '';
    position: absolute;
    top: 0;
    left: var(--gutter);
    right: var(--gutter);
    height: 1px;
    background: var(--line);
  }
  .footer-statement {
    color: var(--text-2);
    font-size: 14px;
  }
  .footer-statement a {
    font-weight: 500;
  }
  .footer-copy .mono {
    font-size: 12.5px;
  }
  @media (max-width: 899px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }
    .footer-brand {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 959px) {
    .footer-col a {
      min-height: 44px;
    }
    .footer-statement a {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
    }
  }
  @media (max-width: 420px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 28px;
    }
  }
</style>
