---
import { PLANS, PLAN_GROUPS, getPlan } from '../../data/plans';
const minMonthly = Math.min(...PLANS.filter((p) => p.paymentCycle === 'month').map((p) => p.priceAmount));
const yearPlan = getPlan('chuanyun');
import PlanCard from './PlanCard.astro';
---
<section class="section" id="plans" aria-labelledby="plans-title">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">套餐方案</p>
      <h2 id="plans-title">灵动云机场套餐价格：{PLANS.length} 档方案</h2>
      <p>月付机场、年付机场与不限时流量包一次看全：月付 ¥{minMonthly} 起，年付 {yearPlan.displayPrice}{yearPlan.displayPriceSuffix} 每月 {yearPlan.displayTraffic.replace('/月', '')}，一次性流量包不按月续费。每张卡片分开标注付款方式与流量周期，方便对比性价比。</p>
    </div>

    <ul class="plan-legend" aria-label="套餐类型说明">
      {PLAN_GROUPS.map((g) => (
        <li class={`lg-${g.key}`}>
          <strong>{g.title}</strong>
          <span>{g.desc}</span>
        </li>
      ))}
    </ul>

    <div class="plan-grid">
      {PLANS.map((p) => <PlanCard plan={p} />)}
    </div>

  </div>
</section>

<style>
  .plan-legend {
    list-style: none;
    padding: 0;
    margin: 0 auto 36px;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
  }
  .plan-legend li {
    display: flex;
    gap: 8px;
    align-items: baseline;
    font-size: 14px;
    padding: 8px 14px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: #fff;
  }
  .plan-legend strong {
    color: var(--ink);
    white-space: nowrap;
  }
  .plan-legend span {
    color: var(--muted);
  }
  .plan-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    column-gap: 20px;
    row-gap: 34px;
  }
  @media (max-width: 1199px) {
    .plan-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 639px) {
    .plan-grid {
      grid-template-columns: 1fr;
    }
    .plan-legend {
      flex-direction: column;
      align-items: stretch;
    }
    .plan-legend li {
      border-radius: 12px;
      flex-wrap: wrap;
      row-gap: 0;
    }
  }
</style>
