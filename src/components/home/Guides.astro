---
import { getCollection } from 'astro:content';
import GuideCard from '../GuideCard.astro';

const guides = (await getCollection('guides', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
---
<section class="section section--soft" id="guides" aria-labelledby="guides-title">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">全部教程</p>
      <h2 id="guides-title">全部 {guides.length} 篇教程</h2>
      <p>从选客户端、看懂概念，到 Clash、Clash Party、小火箭、v2rayN 和 v2rayNG 的导入与设置，每篇只讲一件事。</p>
    </div>
    <div class="guide-index">
      {guides.map((g) => (
        <GuideCard
          slug={g.id}
          title={g.data.title}
          shortTitle={g.data.shortTitle}
          description={g.data.description}
          category={g.data.category}
          date={g.data.updatedDate ?? g.data.pubDate}
          variant="row"
        />
      ))}
    </div>
    <p class="more"><a class="btn btn--ghost" href="/guides/">按设备浏览教程目录</a></p>
  </div>
</section>

<style>
  /* 文档目录：一块面板，单列条目，细线分隔 */
  .guide-index {
    display: grid;
    padding: 8px;
    border-radius: var(--r-lg);
    background: var(--bg);
    border: 1px solid var(--line);
  }
  .guide-index > :global(.guide-card + .guide-card) {
    border-top: 1px solid var(--line);
  }
  .more {
    margin-top: 32px;
  }
  @media (max-width: 639px) {
    .guide-index {
      padding: 4px 12px;
    }
  }
</style>
