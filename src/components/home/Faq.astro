---
import { FAQS } from '../../data/faq';
import { LINKS } from '../../config/site';
---
<section class="section" id="faq" aria-labelledby="faq-title">
  <div class="container faq-wrap">
    <div class="section-head">
      <p class="eyebrow">常见问题</p>
      <h2 id="faq-title">使用中的常见问题</h2>
      <p>订阅链接、订阅格式、多设备、更新频率、代理模式和连接异常，导入和日常使用时最常被问到的 {FAQS.length} 个问题。</p>
    </div>
    <ol class="faq-list">
      {FAQS.map((f, i) => (
        <li class="faq-item" id={`faq-${i + 1}`}>
          <h3 class="faq-q"><span class="faq-n" aria-hidden="true">Q{i + 1}</span>{f.q}</h3>
          <div class="faq-a">
            {f.a.map((p) => <p set:html={p} />)}
          </div>
        </li>
      ))}
    </ol>
    <div class="faq-cta">
      <p>
        没找到你的问题？先浏览<a href="/guides/">全部教程</a>；连接类问题可以到<a href={LINKS.helpCenter}>帮助中心</a>查找答案或联系在线客服。
      </p>
    </div>
  </div>
</section>

<style>
  .faq-wrap {
    max-width: calc(880px + var(--gutter) * 2);
  }
  .faq-wrap :global(.section-head) {
    grid-template-columns: minmax(0, 1fr);
  }
  .faq-wrap :global(.section-head > p:not(.eyebrow)) {
    grid-column: 1;
    grid-row: 3;
    margin-top: 14px;
    max-width: 56em;
    text-wrap: balance;
  }
  /* 文档式问答：一块面板，问题之间细线分隔 */
  .faq-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .faq-item {
    display: grid;
    grid-template-columns: 56px minmax(0, 1fr);
    padding: 28px 0;
    border-bottom: 1px solid var(--line);
  }
  .faq-q {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: 56px minmax(0, 1fr);
    align-items: baseline;
    font-size: var(--fs-md);
    font-weight: 600;
    line-height: 1.55;
    margin-bottom: 10px;
    text-wrap: pretty;
  }
  .faq-n {
    font-family: var(--mono);
    font-size: 13px;
    font-weight: 500;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }
  .faq-a {
    grid-column: 2;
    display: grid;
    gap: 10px;
    color: var(--muted);
    line-height: 1.85;
    font-size: 15.5px;
  }
  .faq-cta {
    margin-top: 32px;
    padding: 18px 22px;
    border-radius: var(--r);
    background: var(--bg-band);
    border: 1px solid var(--line);
  }
  .faq-cta p {
    color: var(--text-2);
  }
  @media (max-width: 639px) {
    .faq-item {
      grid-template-columns: minmax(0, 1fr);
      padding: 22px 0;
    }
    .faq-q {
      grid-template-columns: 40px minmax(0, 1fr);
      font-size: 17px;
    }
    .faq-a {
      grid-column: 1;
      padding-left: 40px;
    }
  }
  @media (max-width: 400px) {
    .faq-a {
      padding-left: 0;
    }
  }
</style>
