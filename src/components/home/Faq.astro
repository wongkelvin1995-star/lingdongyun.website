---
import { FAQS } from '../../data/faq';
import ActionLink from '../ActionLink.astro';
---
<section class="section" id="faq" aria-labelledby="faq-title">
  <div class="container faq-wrap">
    <div class="section-head">
      <p class="eyebrow">常见问题</p>
      <h2 id="faq-title">灵动云常见问题（FAQ）</h2>
      <p>关于灵动云机场的价格、套餐区别、客户端、订阅导入、线路与试用，新用户最常问的 10 个问题。</p>
    </div>
    <ol class="faq-list">
      {FAQS.map((f, i) => (
        <li class="faq-item" id={`faq-${i + 1}`}>
          <h3 class="faq-q"><span class="faq-n" aria-hidden="true">Q{i + 1}</span>{f.q}</h3>
          <div class="faq-a">
            {f.a.map((p) => <p set:html={p} />)}
          </div>
        </li>
      ))}
    </ol>
    <div class="faq-cta">
      <p>准备好了？注册后即可在用户中心选择套餐。</p>
      <ActionLink>注册并订购</ActionLink>
    </div>
  </div>
</section>

<style>
  .faq-wrap {
    max-width: 880px;
  }
  .faq-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 14px;
  }
  .faq-item {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 20px 22px;
  }
  .faq-q {
    display: flex;
    gap: 12px;
    align-items: baseline;
    font-size: 17px;
    font-weight: 700;
    margin-bottom: 10px;
    text-wrap: balance;
  }
  .faq-n {
    flex: none;
    font-size: 13px;
    font-weight: 700;
    color: var(--brand-ink);
    background: var(--tint);
    border-radius: 6px;
    padding: 1px 7px;
    font-variant-numeric: tabular-nums;
  }
  .faq-a {
    display: grid;
    gap: 10px;
    color: var(--text);
    padding-left: 46px;
  }
  .faq-cta {
    margin-top: 32px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 22px 24px;
    border-radius: 16px;
    background: var(--tint);
    border: 1px solid #e7defe;
  }
  .faq-cta p {
    color: var(--ink);
    font-weight: 600;
  }
  @media (max-width: 639px) {
    .faq-item {
      padding: 16px;
    }
    .faq-a {
      padding-left: 0;
    }
    .faq-cta :global(.btn) {
      width: 100%;
    }
  }
</style>
