---
import { FAQS } from '../../data/faq';
import ActionLink from '../ActionLink.astro';
---
<section class="section" id="faq" aria-labelledby="faq-title">
  <div class="container faq-wrap">
    <div class="section-head">
      <p class="eyebrow">常见问题</p>
      <h2 id="faq-title">灵动云常见问题</h2>
      <p>涉及当前条款（重置日、设备数、退款等）的问题，请以用户中心显示为准。</p>
    </div>
    <div class="faq-list">
      {FAQS.map((f, i) => (
        <details class="faq-item" open={i === 0}>
          <summary><h3>{f.q}</h3></summary>
          <div class="faq-a">
            {f.a.map((p) => <p set:html={p} />)}
          </div>
        </details>
      ))}
    </div>
    <div class="faq-cta">
      <p>准备好了？注册后即可在用户中心选择套餐。</p>
      <ActionLink>注册并订购</ActionLink>
    </div>
  </div>
</section>

<style>
  .faq-wrap {
    max-width: 880px;
  }
  .faq-list {
    display: grid;
    gap: 12px;
  }
  .faq-item {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 14px;
    transition: border-color 0.2s ease;
  }
  .faq-item[open] {
    border-color: #cfc3f8;
    background: linear-gradient(180deg, #fbf9ff, #fff 50%);
  }
  summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 16px 20px;
    min-height: 56px;
    border-radius: 14px;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary h3 {
    font-size: 16.5px;
    font-weight: 600;
  }
  summary::after {
    content: '';
    flex: none;
    width: 10px;
    height: 10px;
    border-right: 2px solid var(--brand);
    border-bottom: 2px solid var(--brand);
    transform: rotate(45deg) translateY(-3px);
    transition: transform 0.2s ease;
  }
  .faq-item[open] summary::after {
    transform: rotate(-135deg) translateY(-2px);
  }
  .faq-a {
    padding: 0 20px 18px;
    display: grid;
    gap: 10px;
    color: var(--text);
  }
  .faq-cta {
    margin-top: 32px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 22px 24px;
    border-radius: 16px;
    background: var(--tint);
    border: 1px solid #e7defe;
  }
  .faq-cta p {
    color: var(--ink);
    font-weight: 600;
  }
  @media (max-width: 639px) {
    summary {
      padding: 14px 16px;
    }
    .faq-a {
      padding: 0 16px 16px;
    }
    .faq-cta :global(.btn) {
      width: 100%;
    }
  }
</style>
